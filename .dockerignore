# Dependencies & build output — reinstalled/rebuilt inside the image
node_modules
.next
out
build
coverage

# Env files — never bake secrets into the image; set them in EasyPanel
.env
.env.*
!.env.local.example
!.env.example

# VCS & tooling
.git
.github
.gitignore
.vscode
.idea

# Local / editor noise
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# Docs & meta not needed at runtime
docs
*.md
!README.md

# Tests
**/*.test.ts
**/*.test.tsx
vitest.config.ts
